<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/FirstFragment">

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.fa.employeemanager.FirstFragment"
        android:label="Liste des employés"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_FirstFragment_to_SecondFragment"
            app:destination="@id/SecondFragment" />
    </fragment>
    <fragment
        android:id="@+id/SecondFragment"
        android:name="com.fa.employeemanager.SecondFragment"
        android:label="Ajouter un employée"
        tools:layout="@layout/fragment_second">

        <action
            android:id="@+id/action_SecondFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />
    </fragment>
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.fa.employeemanager.SettingsFragment"
        android:label="Paramètres" />
    <fragment
        android:id="@+id/histogramme"
        android:name="com.fa.employeemanager.StatistiqueFragment"
        android:label="Statistique" />

</navigation>